# Per-repo secret detection exclusions for pdc-tf-modules.
# One regex per line; lines starting with # are comments.
# These supplement the global exclusions in scripts/detect_secrets_baseline.sh.

# Documentation files contain placeholder/example credentials only
README\.md
CHANGELOG\.md
.*\/README\.md

# Terraform example/placeholder values in variable definitions and READMEs
.*\.tfvars\.example
.*\.tfvars\.sample

# Terraform archive — historical modules no longer in active use
terraform\.archive\/.*
